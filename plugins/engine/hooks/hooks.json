{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^AskUserQuestion$",
        "hooks": [{
          "type": "command",
          "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/gear\" --host claude adapter --handler question_boundary --matcher-pattern '^AskUserQuestion$'",
          "onFailure": "block",
          "statusMessage": "Checking Engine question cutoff"
        }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/gear\" --host claude adapter --handler session_recall --matcher-pattern 'startup|clear|compact'" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/gear\" --host claude adapter --handler stop_reminder --matcher-pattern \"\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/gear\" --host claude adapter --handler state_nudge --matcher-pattern '.*'" }]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/gear\" --host claude adapter --handler compaction_observe --matcher-pattern 'manual|auto'" }]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/gear\" --host claude adapter --handler compaction_observe --matcher-pattern 'manual|auto'" }]
      }
    ]
  }
}
