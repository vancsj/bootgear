{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/gear\" --host codex adapter --handler question_boundary --matcher-pattern '^request_user_input$'",
            "statusMessage": "Checking Engine question cutoff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/gear\" --host codex adapter --handler stop_reminder --matcher-pattern \"\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/gear\" --host codex adapter --handler session_recall --matcher-pattern '^(startup|resume|clear|compact|fork)$'",
            "statusMessage": "Restoring engine context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/gear\" --host codex adapter --handler state_nudge --matcher-pattern '.*'"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/gear\" --host codex adapter --handler stop_reminder --matcher-pattern '.*'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/gear\" --host codex adapter --handler compaction_observe --matcher-pattern 'manual|auto'"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/gear\" --host codex adapter --handler compaction_observe --matcher-pattern 'manual|auto'"
          }
        ]
      }
    ]
  }
}
