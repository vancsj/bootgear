      "files": [
        {"path": ".bootgear/session/fixture-claude.md", "text": "active run\n"}
      ]
    },
    "expected": {
      "stdout": "{\"hookSpecificOutput\":{\"hookEventName\":\"Stop\",\"additionalContext\":\"An engine run is active in this session (fixture-claude). Before treating this as a natural stopping point, call recall to re-read the settlement and open todos from the ledger, and check state against /goal's succeeded/failed conditions \\u2014 don't rely on this turn's own memory of them.\"}}\n",
      "stderr": "",
      "decision": "add_context",
      "exit": 0,
      "marker": {
        "path": ".bootgear/session/.fixture-claude.stop_reminder_state",
        "contains": {"nudge_count": 1}
      }
    }
  },
