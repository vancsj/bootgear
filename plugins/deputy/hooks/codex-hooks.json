{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/gear\" --host codex hook --host codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
