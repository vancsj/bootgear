{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/hooks/gear\" --host codex coordination-hook" }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/hooks/gear\" --host codex session-start" }]
      }
    ]
  }
}
