{
  "include": [
    "../plugins/cli",
    "../plugins/engine",
    "../plugins/converge",
    "../plugins/review",
    "../plugins/spec",
    "."
  ],
  "pythonVersion": "3.11",
  "typeCheckingMode": "standard",
  "executionEnvironments": [
    {
      "root": "../plugins/cli",
      "extraPaths": [
        "../plugins/cli/src"
      ]
    },
    {
      "root": "../plugins/engine",
      "extraPaths": [
        "../plugins/engine/src",
        "../plugins/cli/src"
      ]
    },
    {
      "root": "../plugins/converge",
      "extraPaths": [
        "../plugins/converge/src",
        "../plugins/cli/src"
      ]
    },
    {
      "root": "../plugins/review",
      "extraPaths": [
        "../plugins/review/src",
        "../plugins/cli/src",
        "../plugins/converge/src"
      ]
    },
    {
      "root": "../plugins/spec",
      "extraPaths": [
        "../plugins/spec/src",
        "../plugins/converge/src",
        "../plugins/cli/src"
      ]
    },
    {
      "root": ".",
      "extraPaths": [
        "..",
        "../plugins/cli/src"
      ]
    }
  ]
}
